{
  "name": "an-pos",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "out/main/index.js",
  "description": "نظام نقاط البيع وإدارة المخزون والمبيعات AN POS",
  "author": "Ammar Naass",
  "scripts": {
    "dev": "electron-vite dev --config electron.vite.config.ts",
    "build": "electron-vite build --config electron.vite.config.ts",
    "preview": "electron-vite preview --config electron.vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "package": "electron-vite build --config electron.vite.config.ts && electron-builder",
    "package:win": "electron-vite build --config electron.vite.config.ts && electron-builder --win",
    "package:win:x64": "electron-vite build --config electron.vite.config.ts && electron-builder --win --x64",
    "package:win:ia32": "electron-vite build --config electron.vite.config.ts && electron-builder --win --ia32",
    "package:win:all": "electron-vite build --config electron.vite.config.ts && electron-builder --win --x64 --ia32",
    "package:win:portable": "electron-vite build --config electron.vite.config.ts && electron-builder --win portable",
    "set-version": "node scripts/set-version.mjs",
    "bump:patch": "node scripts/set-version.mjs patch",
    "bump:minor": "node scripts/set-version.mjs minor",
    "bump:major": "node scripts/set-version.mjs major",
    "cert:generate-dev": "node scripts/generate-dev-cert.mjs",
    "verify:signatures": "node scripts/verify-signature.mjs",
    "package:win:signed": "electron-vite build --config electron.vite.config.ts && electron-builder --win -c.forceCodeSigning=true"
  },
  "build": {
    "appId": "com.anpos.desktop",
    "productName": "AN POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/node_modules/*-linux-*/**",
      "!**/node_modules/*-darwin-*/**",
      "!**/node_modules/*-android-*/**",
      "!**/node_modules/@napi-rs/**",
      "!**/node_modules/@rolldown/**",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.md"
    ],
    "extraResources": [
      {
        "from": "public/an-pos-icon.png",
        "to": "an-pos-icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "electron/drizzle/migrations",
        "to": "drizzle"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "public/an-pos-icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "publisherName": "AN POS",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/installer.ico",
      "uninstallerIcon": "build/uninstaller.ico",
      "installerHeaderIcon": "build/installer.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AN POS",
      "uninstallDisplayName": "AN POS",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "electron/installer.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.exe"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.exe",
      "requestExecutionLevel": "user"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "public/an-pos-icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ammarnaass",
        "repo": "AN-POS-TEST",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fastify/cors": "^11.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.3",
    "bonjour-service": "^1.4.4",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "fastify": "^5.11.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.9.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "electron": "40.10.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.69.0",
    "pdfjs-dist": "^6.3.289",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.2"
  }
}
