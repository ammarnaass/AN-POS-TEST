<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="AppShortcuts">
      <!-- اختصار قائمة ابدأ -->
      <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="{5A3E269D-FE19-4841-BCE5-225916A8CE01}">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="AN POS"
                  Description="نظام نقاط البيع وإدارة المخزون والمبيعات AN POS"
                  Target="[!AnPosExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="CleanUpStartMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\AN POS\Installer"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <!-- اختصار سطح المكتب (اختياري حسب خاصية CREATE_DESKTOP_SHORTCUT) -->
      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="{8E17D23A-3990-410E-90BF-DF8F02BE9720}" Condition="CREATE_DESKTOP_SHORTCUT = 1">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="AN POS"
                  Description="نظام نقاط البيع وإدارة المخزون والمبيعات AN POS"
                  Target="[!AnPosExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\AN POS\Installer"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
